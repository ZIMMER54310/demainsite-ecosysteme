# SharePoint item IDs in the existing reference lists. Configure only after
# validating each value against the corresponding SharePoint list.
DSE_OVH_DOMAIN_TYPE_ID=
DSE_OVH_CLIENT_ID=
DSE_OVH_SUBSCRIPTION_ID=
DSE_OVH_DOMAIN_ACTIVE_ID=
DSE_OVH_DOMAIN_VALID_ID=
DSE_OVH_DOMAIN_LOCKED_ID=

# Optional drift guards. The service resolves OVH and Construction by label,
# then compares against these IDs when they are provided.
DSE_OVH_EXPECTED_SUPPLIER_ID=
DSE_OVH_EXPECTED_CONSTRUCTION_STATUS_ID=

# Defaults to /var/log/dse/domain-sync.jsonl.
DSE_DOMAIN_SYNC_LOG_DIR=/var/log/dse
