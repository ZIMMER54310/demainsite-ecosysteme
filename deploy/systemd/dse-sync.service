[Unit]
Description=DSE: OVH -> SharePoint -> DNS -> Nginx -> HTTPS
After=network-online.target dse-api.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/dse/demainsite-ecosysteme/api
ExecStartPre=-/usr/bin/node tools/sync-ovh-sharepoint.js --apply
ExecStart=/usr/bin/node tools/sync-domaines.js --dns --nginx --https --tous
