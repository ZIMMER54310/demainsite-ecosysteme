"use strict";

require("dotenv").config();

const express = require("express");

const controleurEtat =
  require("./dseEtat");

const controleurMoi =
  require("./dseMoi");

const controleurSiteParDomaine =
  require("./dseSiteParDomaine");

const controleurSiteParId =
  require("./dseSiteParId");

const controleurSiteComplet =
  require("./dseSiteComplet");

const application = express();

application.disable("x-powered-by");
application.set("trust proxy", 1);

application.use(
  express.json({
    limit: "1mb"
  })
);

function originesAutorisees() {
  return String(
    process.env.DSE_ALLOWED_ORIGINS || ""
  )
    .split(",")
    .map(
      (origine) =>
        origine.trim()
    )
    .filter(Boolean);
}

application.use(
  (req, res, suivant) => {
    const origine =
      req.headers.origin;

    const autorisees =
      originesAutorisees();

    if (
      origine &&
      autorisees.includes(origine)
    ) {
      res.setHeader(
        "Access-Control-Allow-Origin",
        origine
      );

      res.setHeader(
        "Vary",
        "Origin"
      );
    }

    res.setHeader(
      "Access-Control-Allow-Methods",
      "GET,OPTIONS"
    );

    res.setHeader(
      "Access-Control-Allow-Headers",
      "Accept,Content-Type,Authorization"
    );

    if (req.method === "OPTIONS") {
      return res.status(204).end();
    }

    suivant();
  }
);

function adapterControleur(
  controleur
) {
  return async function (
    req,
    res
  ) {
    const contexte = {
      res: null,

      log: {
        info:
          (...argumentsLog) =>
            console.log(...argumentsLog),

        warn:
          (...argumentsLog) =>
            console.warn(...argumentsLog),

        error:
          (...argumentsLog) =>
            console.error(...argumentsLog)
      }
    };

    try {
      await controleur(
        contexte,
        req
      );

      const resultat =
        contexte.res || {};

      const status =
        Number(
          resultat.status ||
          resultat.statusCode ||
          200
        );

      const headers =
        resultat.headers || {};

      for (
        const [nom, valeur]
        of Object.entries(headers)
      ) {
        if (
          valeur !== undefined &&
          valeur !== null
        ) {
          res.setHeader(
            nom,
            String(valeur)
          );
        }
      }

      if (
        resultat.body === undefined ||
        resultat.body === null
      ) {
        return res
          .status(status)
          .end();
      }

      if (
        typeof resultat.body === "object"
      ) {
        return res
          .status(status)
          .json(resultat.body);
      }

      return res
        .status(status)
        .send(resultat.body);
    } catch (erreur) {
      console.error(
        "[DSE API OVH]",
        erreur
      );

      return res
        .status(
          erreur.status || 500
        )
        .json({
          succes: false,

          erreur: {
            code:
              erreur.codeDse ||
              "DSE-API-ERREUR-INTERNE",

            message:
              "Le service DSE est indisponible."
          },

          meta: {
            genereLe:
              new Date()
                .toISOString()
          }
        });
    }
  };
}

function erreurDse(
  status,
  code,
  message
) {
  const erreur =
    new Error(message);

  erreur.status = status;
  erreur.codeDse = code;

  return erreur;
}

async function obtenirJetonGraph() {
  const tenantId =
    process.env.DSE_TENANT_ID;

  const clientId =
    process.env.DSE_CLIENT_ID;

  const clientSecret =
    process.env.DSE_CLIENT_SECRET;

  if (
    !tenantId ||
    !clientId ||
    !clientSecret
  ) {
    throw erreurDse(
      500,
      "DSE-MEDIA-CONFIGURATION-ABSENTE",
      "La configuration Microsoft Graph est absente."
    );
  }

  const corps =
    new URLSearchParams({
      client_id: clientId,
      client_secret: clientSecret,
      scope:
        "https://graph.microsoft.com/.default",
      grant_type:
        "client_credentials"
    });

  const reponse =
    await fetch(
      `https://login.microsoftonline.com/${encodeURIComponent(
        tenantId
      )}/oauth2/v2.0/token`,
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/x-www-form-urlencoded"
        },

        body: corps
      }
    );

  const resultat =
    await reponse.json();

  if (
    !reponse.ok ||
    !resultat.access_token
  ) {
    console.error(
      "[DSE MEDIA] Jeton Graph refusé",
      resultat
    );

    throw erreurDse(
      502,
      "DSE-MEDIA-JETON-GRAPH-REFUSE",
      "Microsoft Graph a refusé l’authentification."
    );
  }

  return resultat.access_token;
}

async function appelGraphJson(
  jeton,
  chemin
) {
  const reponse =
    await fetch(
      `https://graph.microsoft.com/v1.0${chemin}`,
      {
        headers: {
          Authorization:
            `Bearer ${jeton}`,
          Accept:
            "application/json"
        }
      }
    );

  const corps =
    await reponse.json();

  if (!reponse.ok) {
    console.error(
      "[DSE MEDIA] Erreur Graph",
      reponse.status,
      corps
    );

    throw erreurDse(
      reponse.status === 404
        ? 404
        : 502,
      "DSE-MEDIA-GRAPH-REFUSE",
      "Microsoft Graph n’a pas retourné la ressource demandée."
    );
  }

  return corps;
}

async function obtenirSiteId(
  jeton
) {
  const hostname =
    process.env
      .DSE_SHAREPOINT_HOSTNAME;

  const cheminSite =
    process.env
      .DSE_SHAREPOINT_SITE_PATH;

  if (
    !hostname ||
    !cheminSite
  ) {
    throw erreurDse(
      500,
      "DSE-MEDIA-SITE-ABSENT",
      "La configuration du site SharePoint est absente."
    );
  }

  const site =
    await appelGraphJson(
      jeton,
      `/sites/${hostname}:${cheminSite}:`
    );

  if (!site.id) {
    throw erreurDse(
      502,
      "DSE-MEDIA-SITE-ID-ABSENT",
      "L’identifiant SharePoint du site est absent."
    );
  }

  return site.id;
}

function trouverValeurChamp(
  champs,
  motRecherche
) {
  const mot =
    String(motRecherche)
      .toUpperCase();

  for (
    const [nom, valeur]
    of Object.entries(champs)
  ) {
    if (
      nom
        .toUpperCase()
        .includes(mot) &&
      valeur !== undefined &&
      valeur !== null &&
      String(valeur).trim() !== ""
    ) {
      return String(valeur).trim();
    }
  }

  return "";
}

async function obtenirMedia(
  jeton,
  siteId,
  mediaId
) {
  return appelGraphJson(
    jeton,
    `/sites/${encodeURIComponent(
      siteId
    )}/lists/OBJ-MEDIA/items/${encodeURIComponent(
      mediaId
    )}?expand=fields`
  );
}

application.get(
  "/api/v1/etat",
  adapterControleur(
    controleurEtat
  )
);

application.get(
  "/api/v1/moi",
  adapterControleur(
    controleurMoi
  )
);

application.get(
  "/api/v1/sites/par-domaine",
  adapterControleur(
    controleurSiteParDomaine
  )
);

application.get(
  "/api/v1/site/:siteId",
  adapterControleur(
    controleurSiteParId
  )
);

application.get(
  "/api/v1/site-complet/:siteId",
  adapterControleur(
    controleurSiteComplet
  )
);

application.get(
  "/api/v1/media/:mediaId",
  async (
    req,
    res
  ) => {
    try {
      const mediaId =
        String(
          req.params.mediaId || ""
        ).trim();

      if (
        !/^[0-9]+$/.test(mediaId)
      ) {
        return res
          .status(400)
          .json({
            succes: false,

            erreur: {
              code:
                "DSE-MEDIA-ID-INVALIDE",

              message:
                "L’identifiant du média est invalide."
            }
          });
      }

      const jeton =
        await obtenirJetonGraph();

      const siteId =
        await obtenirSiteId(
          jeton
        );

      const media =
        await obtenirMedia(
          jeton,
          siteId,
          mediaId
        );

      const champs =
        media.fields || {};

      const graphItemId =
        trouverValeurChamp(
          champs,
          "GRAPH"
        );

      const driveId =
        trouverValeurChamp(
          champs,
          "DRIVE"
        );

      if (
        !graphItemId ||
        !driveId
      ) {
        throw erreurDse(
          404,
          "DSE-MEDIA-FICHIER-NON-LIE",
          "Le média ne possède pas de fichier SharePoint lié."
        );
      }

      const informationsFichier =
        await appelGraphJson(
          jeton,
          `/drives/${encodeURIComponent(
            driveId
          )}/items/${encodeURIComponent(
            graphItemId
          )}`
        );

      const reponseFichier =
        await fetch(
          `https://graph.microsoft.com/v1.0/drives/${encodeURIComponent(
            driveId
          )}/items/${encodeURIComponent(
            graphItemId
          )}/content`,
          {
            headers: {
              Authorization:
                `Bearer ${jeton}`
            },

            redirect: "follow"
          }
        );

      if (!reponseFichier.ok) {
        console.error(
          "[DSE MEDIA] Téléchargement refusé",
          reponseFichier.status
        );

        throw erreurDse(
          reponseFichier.status === 404
            ? 404
            : 502,
          "DSE-MEDIA-CONTENU-INDISPONIBLE",
          "Le contenu du média est indisponible."
        );
      }

      const contenu =
        Buffer.from(
          await reponseFichier
            .arrayBuffer()
        );

      const typeContenu =
        informationsFichier.file
          ?.mimeType ||
        reponseFichier.headers
          .get("content-type") ||
        "application/octet-stream";

      const nomFichier =
        informationsFichier.name ||
        `media-${mediaId}`;

      res.setHeader(
        "Content-Type",
        typeContenu
      );

      res.setHeader(
        "Content-Length",
        String(contenu.length)
      );

      res.setHeader(
        "Content-Disposition",
        `inline; filename="${nomFichier.replace(
          /"/g,
          ""
        )}"`
      );

      res.setHeader(
        "Cache-Control",
        "public, max-age=300"
      );

      res.setHeader(
        "X-DSE-Media-ID",
        mediaId
      );

      res.setHeader(
        "X-Content-Type-Options",
        "nosniff"
      );

      return res
        .status(200)
        .send(contenu);
    } catch (erreur) {
      console.error(
        "[DSE MEDIA]",
        erreur
      );

      return res
        .status(
          erreur.status || 500
        )
        .json({
          succes: false,

          erreur: {
            code:
              erreur.codeDse ||
              "DSE-MEDIA-ERREUR-INTERNE",

            message:
              erreur.message ||
              "Le média est indisponible."
          },

          meta: {
            genereLe:
              new Date()
                .toISOString()
          }
        });
    }
  }
);

application.use(
  "/api",
  (req, res) => {
    res.status(404).json({
      succes: false,

      erreur: {
        code:
          "DSE-API-ROUTE-ININTROUVABLE",

        message:
          "La route demandee est introuvable."
      },

      meta: {
        genereLe:
          new Date()
            .toISOString()
      }
    });
  }
);

const port =
  Number(
    process.env.PORT || 3000
  );

const serveur =
  application.listen(
    port,
    "127.0.0.1",
    () => {
      console.log(
        `[DSE API OVH] Disponible sur 127.0.0.1:${port}`
      );
    }
  );

function arreter(signal) {
  console.log(
    `[DSE API OVH] Arret demande : ${signal}`
  );

  serveur.close(
    () => {
      console.log(
        "[DSE API OVH] Arret termine"
      );

      process.exit(0);
    }
  );
}

process.on(
  "SIGTERM",
  () => arreter("SIGTERM")
);

process.on(
  "SIGINT",
  () => arreter("SIGINT")
);